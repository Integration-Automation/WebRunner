{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebRunner local agent task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "start_url",
    "success"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "start_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "backend": {
      "enum": [
        "selenium",
        "playwright"
      ],
      "default": "selenium"
    },
    "planner": {
      "enum": [
        "steps",
        "ollama"
      ],
      "default": "steps"
    },
    "model": {
      "type": "string",
      "description": "Explicitly installed local open-source model name."
    },
    "success": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "url_contains",
              "text_contains",
              "visible",
              "extracted_equals"
            ]
          },
          "value": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "frame": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "navigate",
              "click",
              "fill",
              "select",
              "check",
              "scroll",
              "wait",
              "extract",
              "done"
            ]
          },
          "selector": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "frame": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_env": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "default": 25
    },
    "timeout": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 300
    },
    "action_timeout": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 15
    },
    "headless": {
      "type": "boolean",
      "default": true
    }
  }
}
